# Copy to .env and fill in. Blank values are treated as "not configured".
APP_NAME=Chesterton

# Gemini: Gemini API (AI Studio key) by default; set TRUE to use Vertex AI via ADC.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Firestore
FIRESTORE_DATABASE=(default)

# Model IDs (written by backend/scripts/smoke_gemini.py)
MODEL_MAIN=
MODEL_SCREEN=

# GitHub
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_DEMO_REPO=owner/repo
SMEE_URL=

# Optional: override where the built frontend is served from
FRONTEND_DIST=
