# Copy to .env and fill in. Blank values are treated as "not configured".
APP_NAME=Chesterton

# Gemini: Gemini API (AI Studio key) by default; set TRUE to use Vertex AI via ADC.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Firestore (locally ADC is enough; in Actions this points at the SA key file)
FIRESTORE_DATABASE=(default)
GOOGLE_APPLICATION_CREDENTIALS=

# Model fallback chains (comma-separated, in order). When a model hits its daily
# free-tier quota it is skipped until 00:00 UTC (cached in Firestore meta/model_quota).
# Defaults are used when these are blank.
MODEL_MAIN_CHAIN=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
MODEL_SCREEN_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Optional single models (older setting, written by backend/scripts/smoke_gemini.py);
# if set, tried first, ahead of the chain.
MODEL_MAIN=
MODEL_SCREEN=

# GitHub
GITHUB_TOKEN=
GITHUB_APP_ID=
# Either the key file path (local) or the key contents (the Action passes contents)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_DEMO_REPO=owner/repo
SMEE_URL=

# Optional: override where the built frontend is served from
FRONTEND_DIST=
