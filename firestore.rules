rules_version = '2';

// The public dashboard reads these collections; nothing else is readable and no
// client may write anything. The GitHub Action writes with a service account
// (server SDK), which is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /runs/{runId} {
      allow read: if true;
      allow write: if false;
      match /events/{eventId} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /pr_analyses/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /questions/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /decisions/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /guards/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /backfills/{id} {
      allow read: if true;
      allow write: if false;
      match /items/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }
    // Everything else (including meta/) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
