# Copy to frontend/.env.local (gitignored). These are the Firebase web app's public
# config values (Firebase console → Project settings → Your apps → Web app, or
# `firebase apps:sdkconfig WEB <app id>`). Access is limited by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
